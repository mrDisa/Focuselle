    "sleepPolicy": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переходе Mac в сон таймер ставится на паузу. После пробуждения продолжи его вручную. Закрытие основного окна оставляет таймер в строке меню."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep pauses the timer. Resume manually after waking. Closing the main window keeps the timer in the menu bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ中はタイマーが一時停止します。復帰後に手動で再開してください。メインウインドウを閉じてもメニューバーで動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠时计时器会暂停，唤醒后请手动继续。关闭主窗口后，计时器仍在菜单栏运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 모드에서는 타이머가 일시 정지됩니다. 깨어난 후 직접 재개하세요. 기본 창을 닫아도 메뉴 막대에서 계속 실행됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ruhezustand pausiert der Timer. Setze ihn danach manuell fort. Beim Schließen des Hauptfensters läuft er in der Menüleiste weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille met le minuteur en pause. Reprends-le manuellement au réveil. Fermer la fenêtre principale laisse le minuteur dans la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo pausa el temporizador. Reanúdalo manualmente al despertar. Al cerrar la ventana principal, sigue en la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repouso pausa o timer. Retome manualmente ao despertar. Ao fechar a janela principal, ele continua na barra de menus."
          }
        }
      }
    },

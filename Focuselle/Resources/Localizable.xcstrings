    "sleepPolicy": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переходе Mac в сон таймер ставится на паузу. После пробуждения продолжи его вручную. Закрытие основного окна оставляет таймер в строке меню."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep pauses the timer. Resume manually after waking. Closing the main window keeps the timer in the menu bar."
          }
        }
      }
    },

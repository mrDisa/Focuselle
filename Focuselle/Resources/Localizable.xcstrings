    "noInsights": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится твой ритм после первой сессии."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rhythm will appear after your first session."

          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 하위 작업, 로컬 저장은 추후 추가됩니다. 지금은 작업 없이 집중을 시작하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, Teilaufgaben und lokale Speicherung folgen. Starte zunächst ohne Aufgabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches, sous-tâches et le stockage local arrivent bientôt. Commence sans tâche pour le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximamente: tareas, subtareas y almacenamiento local. Por ahora, inicia un intervalo sin tarea."

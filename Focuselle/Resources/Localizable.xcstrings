    },
    "tasksDetail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран готов к следующему этапу: задачи, подзадачи и локальное хранение. Пока можно запустить фокус без задачи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, subtasks and local storage are next. For now, start a focus interval without a task."
          }
        }
      }
    },
    "statisticsNext": {
      "extractionState": "manual",

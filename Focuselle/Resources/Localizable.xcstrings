    "autoAdvanceDetail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После работы сразу начинается короткий отдых, после любого отдыха — работа. Длинный отдых выбирается вручную."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work starts a short break; any break starts work. Select long breaks manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中後は短い休憩、休憩後は集中に切り替わります。長い休憩は手動で選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作结束后进入短休息，休息结束后开始工作。长休息需手动选择。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 후에는 짧은 휴식, 휴식 후에는 집중이 시작됩니다. 긴 휴식은 직접 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Arbeit folgt eine kurze Pause, nach jeder Pause wieder Arbeit. Lange Pausen wählst du manuell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail lance une pause courte ; toute pause relance le travail. Choisis les pauses longues manuellement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras trabajar empieza un descanso corto; tras cualquier descanso, el trabajo. Selecciona los descansos largos manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após o trabalho começa uma pausa curta; após qualquer pausa, o trabalho. Selecione pausas longas manualmente."
          }
        }
      }
    },

    "updatesDetail": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые версии устанавливаются прямо в приложении. Перед перезапуском текущая сессия сохраняется на паузе."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New versions install within the app. Your current session is saved and paused before restarting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内で新しいバージョンをインストールできます。再起動前にセッションを保存して一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本可在应用内安装。重启前会保存并暂停当前专注时段。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내에서 새 버전을 설치합니다. 재시작 전 현재 세션을 저장하고 일시 정지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Versionen werden in der App installiert. Vor dem Neustart wird die Sitzung gespeichert und pausiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles versions s’installent dans l’app. La session est enregistrée et mise en pause avant le redémarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas versiones se instalan desde la app. Tu sesión se guarda y pausa antes de reiniciar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas versões são instaladas no app. Sua sessão é salva e pausada antes de reiniciar."
          }

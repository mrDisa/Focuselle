    "tasksDetail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран готов к следующему этапу: задачи, подзадачи и локальное хранение. Пока можно запустить фокус без задачи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks, subtasks and local storage are next. For now, start a focus interval without a task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、サブタスク、ローカル保存は今後追加されます。今はタスクなしで集中を始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
